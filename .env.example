# Real sponsor integrations are stubbed with local mocks until these are wired up.
# Copy to .env and fill in when swapping a mock adapter for a real client.
# Never commit the populated .env file.

# Wired up for real: see sentinelops/graph/hydra_live.py and the
# "Real HydraDB integration" section in README.md.
HYDRA_DB_API_KEY=

# Wired up for real (published-result observability only, not full pipeline
# execution - see "Real RocketRide integration" in README.md). Note the SDK's
# own env var spelling: no underscore between API and KEY.
ROCKETRIDE_APIKEY=

PIPESHIFT_API_KEY=

# Wired up for real (audit-log persistence, not the decision logic itself -
# see "Real InsForge integration" in README.md). Each InsForge project has
# its own subdomain, so the base URL is required too.
INSFORGE_API_KEY=
INSFORGE_BASE_URL=

SLACK_BOT_TOKEN=
GITHUB_TOKEN=
LINEAR_API_KEY=
GMAIL_CREDENTIALS_JSON=
